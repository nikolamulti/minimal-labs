{
  "port": 8080,
  "root": ".",
  "open": false,
  "highlight": true,
  "watch": [
    "src",
    "public"
  ],
  "ignore": [
    ".next",
    "node_modules"
  ],
  "remoteLogs": false,
  "useLocalIp": true,
  "injectBody": true,
  "proxy": {
    "/": "http://localhost:3000"
  },
  "hmr": {
    "protocol": "ws",
    "host": "localhost",
    "port": 3000,
    "path": "/_next/webpack-hmr"
  },
  "liveCSS": true,
  "liveImg": true
}
